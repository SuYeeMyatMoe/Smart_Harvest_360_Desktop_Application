<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="SmartHarvest360.controllers.CropSelectionController"
            stylesheets="@../style.css"
            fitToWidth="true" fitToHeight="true" pannable="true"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            styleClass="app-scroll">
    <content>
        <BorderPane prefWidth="960" prefHeight="680" minWidth="720" minHeight="640"
                    styleClass="app-background">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-shell">
                    <padding><Insets top="14" right="30" bottom="14" left="30"/></padding>
                    <ImageView fx:id="appLogo" fitWidth="44" fitHeight="44" preserveRatio="true" smooth="true">
                        <image><Image url="@../images/smartharvest-logo.png"/></image>
                    </ImageView>
                    <VBox spacing="1">
                        <Label text="SmartHarvest 360" styleClass="brand-title"/>
                        <Label text="Farm decision companion" styleClass="brand-caption"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="CHOOSE CROPS" styleClass="screen-badge"/>
                </HBox>
            </top>

            <center>
                <VBox spacing="14" styleClass="content-wrap">
                    <padding><Insets top="18" right="30" bottom="18" left="30"/></padding>

                    <HBox alignment="CENTER" spacing="7">
                        <Label text="1" styleClass="step-dot, step-dot-done"/>
                        <Label text="SETUP" styleClass="step-text"/>
                        <Region styleClass="step-line, step-line-done"/>
                        <Label text="2" styleClass="step-dot, step-dot-active"/>
                        <Label text="CROPS" styleClass="step-text, step-text-active"/>
                        <Region styleClass="step-line"/>
                        <Label text="3" styleClass="step-dot"/>
                        <Label text="SIM" styleClass="step-text"/>
                        <Region styleClass="step-line"/>
                        <Label text="4" styleClass="step-dot"/>
                        <Label text="MARKET" styleClass="step-text"/>
                        <Region styleClass="step-line"/>
                        <Label text="5" styleClass="step-dot"/>
                        <Label text="REPORT" styleClass="step-text"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Crop Selection" styleClass="page-title"/>
                            <Label fx:id="farmSummaryLabel"
                                   text="Browse the crop database and plant at least one crop."
                                   styleClass="page-description"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statusLabel" text="Select a crop to review details."
                               styleClass="status-label"/>
                    </HBox>

                    <HBox spacing="18" VBox.vgrow="ALWAYS">
                        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
                            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="1">
                                    <Label text="Crop Database" styleClass="section-title"/>
                                    <Label text="Loaded from data/crops.csv" styleClass="section-caption"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="CATALOG" styleClass="soft-badge"/>
                            </HBox>
                            <ListView fx:id="cropList" VBox.vgrow="ALWAYS" styleClass="crop-list"/>
                        </VBox>

                        <VBox spacing="14" prefWidth="300">
                            <VBox spacing="10" styleClass="card">
                                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                                <Label text="Crop Details" styleClass="section-title"/>

                                <VBox spacing="4" styleClass="accent-card">
                                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                                    <Label text="SELECTED CROP" styleClass="metric-title"/>
                                    <Label fx:id="selectedNameLabel" text="—" styleClass="metric-value"/>
                                    <Label fx:id="selectedTypeLabel" text="Type: —" styleClass="section-caption"/>
                                </VBox>

                                <HBox spacing="10">
                                    <VBox spacing="3" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                        <Label text="GROWTH BONUS" styleClass="metric-title"/>
                                        <Label fx:id="growthBonusLabel" text="—" styleClass="metric-value"/>
                                    </VBox>
                                    <VBox spacing="3" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                        <Label text="MARKET PRICE" styleClass="metric-title"/>
                                        <Label fx:id="marketPriceLabel" text="—" styleClass="metric-value"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="4" styleClass="warm-card">
                                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                                    <Label text="EXPECTED PROFIT" styleClass="metric-title"/>
                                    <Label fx:id="expectedProfitLabel" text="RM 0.00" styleClass="money-label"/>
                                    <Label fx:id="growthDaysLabel" text="Growth days: —"
                                           styleClass="section-caption"/>
                                </VBox>
                            </VBox>

                            <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Planted on Farm" styleClass="section-title"/>
                                <ListView fx:id="plantedList" prefHeight="140"/>
                                <Label fx:id="plantedCountLabel" text="0 crops planted"
                                       styleClass="section-caption"/>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </center>

            <bottom>
                <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="footer-bar">
                    <padding><Insets top="13" right="30" bottom="13" left="30"/></padding>
                    <Label text="Start Simulation uses the first planted crop as the active season crop."
                           styleClass="section-caption"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addButton" text="Add to Farm" onAction="#handleAddToFarm"
                            styleClass="secondary-button"/>
                    <Button fx:id="startButton" text="Start Simulation" onAction="#handleStartSimulation"
                            disable="true" styleClass="primary-button"/>
                </HBox>
            </bottom>
        </BorderPane>
    </content>
</ScrollPane>
