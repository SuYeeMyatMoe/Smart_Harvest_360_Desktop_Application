<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="SmartHarvest360.controllers.SeasonReportController"
            stylesheets="@../style.css"
            fitToWidth="true" fitToHeight="true" pannable="true"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            styleClass="app-scroll">
    <content>
<BorderPane prefWidth="1180" prefHeight="760" minWidth="980" minHeight="700"
            styleClass="app-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-shell">
            <padding><Insets top="14" right="30" bottom="14" left="30"/></padding>
            <ImageView fx:id="appLogo" fitWidth="44" fitHeight="44" preserveRatio="true" smooth="true">
                <image><Image url="@../images/smartharvest-logo.png"/></image>
            </ImageView>
            <VBox spacing="1">
                <Label text="SmartHarvest 360" styleClass="brand-title"/>
                <Label text="Farm decision companion" styleClass="brand-caption"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="SEASON COMPLETE" styleClass="screen-badge"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="content-wrap">
            <padding><Insets top="16" right="24" bottom="12" left="24"/></padding>

            <HBox alignment="CENTER" spacing="7">
                <Label text="1" styleClass="step-dot, step-dot-done"/>
                <Label text="SETUP" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="2" styleClass="step-dot, step-dot-done"/>
                <Label text="CROPS" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="3" styleClass="step-dot, step-dot-done"/>
                <Label text="SIM" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="4" styleClass="step-dot, step-dot-done"/>
                <Label text="MARKET" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="5" styleClass="step-dot, step-dot-active"/>
                <Label text="REPORT" styleClass="step-text, step-text-active"/>
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Season Report" styleClass="page-title"/>
                    <Label text="Financial outcome with revenue mix and profit comparison."
                           styleClass="page-description"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="SUCCESSFULLY RECORDED" styleClass="soft-badge"/>
            </HBox>

            <HBox spacing="12">
                <VBox spacing="4" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL REVENUE" styleClass="metric-title"/>
                    <Label fx:id="revenueLabel" text="RM 0.00" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="4" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL COST" styleClass="metric-title"/>
                    <Label fx:id="costLabel" text="RM 0.00" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="4" styleClass="accent-card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="NET PROFIT" styleClass="metric-title"/>
                    <Label fx:id="profitLabel" text="RM 0.00" styleClass="profit-label"/>
                </VBox>
                <VBox spacing="4" styleClass="warm-card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="RETURN ON INVESTMENT" styleClass="metric-title"/>
                    <Label fx:id="roiLabel" text="0.00%" styleClass="profit-label"/>
                </VBox>
            </HBox>

            <HBox spacing="14" VBox.vgrow="ALWAYS">
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <HBox spacing="12" VBox.vgrow="ALWAYS">
                        <VBox spacing="4" styleClass="card" HBox.hgrow="ALWAYS">
                            <padding><Insets top="12" right="14" bottom="8" left="14"/></padding>
                            <Label text="Revenue by Crop" styleClass="section-title"/>
                            <Label text="Share of total season revenue."
                                   styleClass="section-caption"/>
                            <PieChart fx:id="revenueChart" legendSide="BOTTOM"
                                      prefHeight="240" maxHeight="260"
                                      styleClass="report-chart"/>
                        </VBox>

                        <VBox spacing="4" styleClass="card" HBox.hgrow="ALWAYS">
                            <padding><Insets top="12" right="14" bottom="8" left="14"/></padding>
                            <Label text="Revenue vs Cost vs Profit" styleClass="section-title"/>
                            <Label text="Season totals in RM."
                                   styleClass="section-caption"/>
                            <BarChart fx:id="financeChart" legendVisible="true"
                                      prefHeight="240" maxHeight="260"
                                      styleClass="report-chart" animated="true">
                                <xAxis>
                                    <CategoryAxis label=""/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="RM"/>
                                </yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="12" prefWidth="300" minWidth="280" styleClass="card">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Season Summary" styleClass="section-title"/>
                    <Label text="Harvest sold and financial results calculated."
                           wrapText="true" maxWidth="Infinity" styleClass="page-description"/>
                    <Separator/>
                    <VBox spacing="6" styleClass="accent-card">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                        <Label text="GRADE COMPARE" styleClass="metric-title"/>
                        <Label fx:id="predictedGradeReportLabel" text="Predicted: -"
                               wrapText="true" maxWidth="Infinity" styleClass="value-label"/>
                        <Label fx:id="actualGradeReportLabel" text="Actual: -"
                               wrapText="true" maxWidth="Infinity" styleClass="value-label"/>
                        <Label fx:id="gradeCoachLabel" text=""
                               wrapText="true" maxWidth="Infinity" styleClass="section-caption"/>
                    </VBox>
                    <VBox spacing="6" styleClass="accent-card">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                        <Label text="REPORT STATUS" styleClass="metric-title"/>
                        <Label fx:id="reportStatusLabel" text="Saving season report..."
                               wrapText="true" maxWidth="Infinity" styleClass="value-label"/>
                        <Label fx:id="filePathLabel" text=""
                               wrapText="true" maxWidth="Infinity" styleClass="section-caption"/>
                    </VBox>
                    <VBox spacing="8" styleClass="warm-card">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                        <Label text="EXPORT" styleClass="metric-title"/>
                        <Label text="Season report is auto-saved under data/. Download one full CSV (summary, sales, and activity), or open the folder."
                               wrapText="true" maxWidth="Infinity" styleClass="section-caption"/>
                        <Button fx:id="downloadReportButton" text="Download full report CSV"
                                onAction="#handleDownloadReport" styleClass="primary-button"
                                maxWidth="Infinity"/>
                        <Button fx:id="openFolderButton" text="Open data folder"
                                onAction="#handleOpenDataFolder" styleClass="secondary-button"
                                maxWidth="Infinity"/>
                    </VBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Start a new season to test another crop strategy."
                           wrapText="true" maxWidth="Infinity" styleClass="section-caption"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="footer-bar">
            <padding><Insets top="13" right="24" bottom="13" left="24"/></padding>
            <Label text="One full CSV covers summary, sales, and activity." styleClass="section-caption"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Exit Application" onAction="#handleExit" styleClass="secondary-button"/>
            <Button fx:id="newSeasonButton" text="Start New Season" onAction="#handleNewSeason"
                    styleClass="primary-button"/>
        </HBox>
    </bottom>
</BorderPane>
    </content>
</ScrollPane>
