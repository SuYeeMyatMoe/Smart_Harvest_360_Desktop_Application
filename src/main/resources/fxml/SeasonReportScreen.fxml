<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="SmartHarvest360.controllers.SeasonReportController"
            stylesheets="@../style.css"
            prefWidth="1180" prefHeight="760" minWidth="760" minHeight="560"
            styleClass="app-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-shell">
            <padding><Insets top="14" right="30" bottom="14" left="30"/></padding>
            <ImageView fx:id="appLogo" fitWidth="44" fitHeight="44" preserveRatio="true" smooth="true">
                <image><Image url="@../images/smartharvest-logo.png"/></image>
            </ImageView>
            <VBox spacing="1">
                <Label text="SmartHarvest 360" styleClass="brand-title"/>
                <Label text="Farm decision companion" styleClass="brand-caption"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="SEASON COMPLETE" styleClass="screen-badge"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="reportScroll" fitToWidth="true" fitToHeight="false" pannable="true"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="app-scroll">
            <content>
        <VBox spacing="12" styleClass="content-wrap">
            <padding><Insets top="16" right="24" bottom="12" left="24"/></padding>

            <HBox alignment="CENTER" spacing="7">
                <Label text="1" styleClass="step-dot, step-dot-done"/>
                <Label text="SETUP" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="2" styleClass="step-dot, step-dot-done"/>
                <Label text="CROPS" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="3" styleClass="step-dot, step-dot-done"/>
                <Label text="SIM" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="4" styleClass="step-dot, step-dot-done"/>
                <Label text="MARKET" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="5" styleClass="step-dot, step-dot-active"/>
                <Label text="REPORT" styleClass="step-text, step-text-active"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="report-hero">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                <VBox spacing="2">
                    <Label text="Season Performance" styleClass="page-title"/>
                    <Label text="Financial outcome with standard charts for revenue, growth, and inputs."
                           styleClass="page-description, report-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="SUCCESSFULLY RECORDED" styleClass="soft-badge"/>
            </HBox>

            <HBox spacing="12">
                <VBox spacing="4" styleClass="metric-card, report-kpi" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL REVENUE" styleClass="metric-title"/>
                    <Label fx:id="revenueLabel" text="RM 0.00" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="4" styleClass="metric-card, report-kpi" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL COST" styleClass="metric-title"/>
                    <Label fx:id="costLabel" text="RM 0.00" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="4" styleClass="accent-card, report-kpi, report-kpi-profit" HBox.hgrow="ALWAYS">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="NET PROFIT" styleClass="metric-title"/>
                    <Label fx:id="profitLabel" text="RM 0.00" styleClass="profit-label"/>
                </VBox>
                <VBox spacing="4" styleClass="warm-card, report-kpi, report-kpi-roi" HBox.hgrow="ALWAYS">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="RETURN ON INVESTMENT" styleClass="metric-title"/>
                    <Label fx:id="roiLabel" text="0.00%" styleClass="profit-label"/>
                </VBox>
            </HBox>

            <HBox spacing="14" VBox.vgrow="ALWAYS">
                <VBox spacing="12" HBox.hgrow="ALWAYS" minWidth="0">
                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="ALWAYS"/>
                            <RowConstraints vgrow="ALWAYS"/>
                        </rowConstraints>

                        <VBox spacing="4" styleClass="card, chart-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <padding><Insets top="12" right="14" bottom="8" left="14"/></padding>
                            <Label text="Revenue by Crop" styleClass="section-title"/>
                            <BarChart fx:id="revenueByCropChart" legendVisible="false" animated="true"
                                      prefHeight="230" minHeight="200" styleClass="report-chart">
                                <xAxis><CategoryAxis label="Crop"/></xAxis>
                                <yAxis><NumberAxis label="RM"/></yAxis>
                            </BarChart>
                        </VBox>

                        <VBox spacing="4" styleClass="card, chart-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <padding><Insets top="12" right="14" bottom="8" left="14"/></padding>
                            <Label text="Revenue vs Cost vs Profit" styleClass="section-title"/>
                            <BarChart fx:id="financeChart" legendVisible="true" animated="true"
                                      prefHeight="230" minHeight="200" styleClass="report-chart">
                                <xAxis><CategoryAxis label="Season"/></xAxis>
                                <yAxis><NumberAxis label="RM"/></yAxis>
                            </BarChart>
                        </VBox>

                        <VBox spacing="4" styleClass="card, chart-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <padding><Insets top="12" right="14" bottom="8" left="14"/></padding>
                            <Label text="Crop Growth by Day" styleClass="section-title"/>
                            <LineChart fx:id="growthChart" createSymbols="false" animated="true"
                                       prefHeight="230" minHeight="200" styleClass="report-chart">
                                <xAxis><NumberAxis label="Day" forceZeroInRange="true"/></xAxis>
                                <yAxis><NumberAxis label="Growth %"/></yAxis>
                            </LineChart>
                        </VBox>

                        <VBox spacing="4" styleClass="card, chart-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <padding><Insets top="12" right="14" bottom="8" left="14"/></padding>
                            <Label text="Water and Fertilizer by Day" styleClass="section-title"/>
                            <AreaChart fx:id="inputChart" createSymbols="false" animated="true"
                                       prefHeight="230" minHeight="200" styleClass="report-chart">
                                <xAxis><NumberAxis label="Day" forceZeroInRange="true"/></xAxis>
                                <yAxis><NumberAxis label="Used"/></yAxis>
                            </AreaChart>
                        </VBox>
                    </GridPane>
                </VBox>

                <VBox spacing="12" prefWidth="300" minWidth="280" styleClass="card">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Season Summary" styleClass="section-title"/>
                    <Separator/>
                    <VBox spacing="6" styleClass="accent-card">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                        <Label text="GRADE COMPARE" styleClass="metric-title"/>
                        <Label fx:id="predictedGradeReportLabel" text="Predicted: -"
                               wrapText="true" maxWidth="Infinity" styleClass="value-label"/>
                        <Label fx:id="actualGradeReportLabel" text="Actual: -"
                               wrapText="true" maxWidth="Infinity" styleClass="value-label"/>
                        <Label fx:id="gradeCoachLabel" text=""
                               wrapText="true" maxWidth="Infinity" styleClass="section-caption"/>
                    </VBox>
                    <VBox spacing="6" styleClass="accent-card">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                        <Label text="REPORT STATUS" styleClass="metric-title"/>
                        <Label fx:id="reportStatusLabel" text="Saving season report..."
                               wrapText="true" maxWidth="Infinity" styleClass="value-label"/>
                        <Label fx:id="filePathLabel" text=""
                               visible="false" managed="false"
                               wrapText="true" maxWidth="Infinity" styleClass="section-caption"/>
                    </VBox>
                    <VBox spacing="8" styleClass="warm-card">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                        <Label text="EXPORT" styleClass="metric-title"/>
                        <Button fx:id="downloadReportButton" text="Download full report CSV"
                                onAction="#handleDownloadReport" styleClass="primary-button"
                                maxWidth="Infinity"/>
                        <Button fx:id="openFolderButton" text="Open data folder"
                                onAction="#handleOpenDataFolder" styleClass="secondary-button"
                                maxWidth="Infinity"/>
                    </VBox>
                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>
        </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="footer-bar">
            <padding><Insets top="13" right="24" bottom="13" left="24"/></padding>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Exit Application" onAction="#handleExit" styleClass="secondary-button"/>
            <Button fx:id="newSeasonButton" text="Start New Season" onAction="#handleNewSeason"
                    styleClass="primary-button"/>
        </HBox>
    </bottom>
</BorderPane>
