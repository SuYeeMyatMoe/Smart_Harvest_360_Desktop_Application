<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="SmartHarvest360.controllers.HarvestMarketController"
            stylesheets="@../style.css"
            fitToWidth="true" fitToHeight="true" pannable="true"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            styleClass="app-scroll">
    <content>
<BorderPane prefWidth="960" prefHeight="680" minWidth="720" minHeight="640"
            styleClass="app-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-shell">
            <padding><Insets top="14" right="30" bottom="14" left="30"/></padding>
            <ImageView fx:id="appLogo" fitWidth="44" fitHeight="44" preserveRatio="true" smooth="true">
                <image><Image url="@../images/smartharvest-logo.png"/></image>
            </ImageView>
            <VBox spacing="1">
                <Label text="SmartHarvest 360" styleClass="brand-title"/>
                <Label text="Farm decision companion" styleClass="brand-caption"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="READY TO SELL" styleClass="screen-badge"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="content-wrap">
            <padding><Insets top="18" right="30" bottom="18" left="30"/></padding>

            <HBox alignment="CENTER" spacing="7">
                <Label text="1" styleClass="step-dot, step-dot-done"/>
                <Label text="SETUP" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="2" styleClass="step-dot, step-dot-done"/>
                <Label text="CROPS" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="3" styleClass="step-dot, step-dot-done"/>
                <Label text="SIM" styleClass="step-text"/>
                <Region styleClass="step-line, step-line-done"/>
                <Label text="4" styleClass="step-dot, step-dot-active"/>
                <Label text="MARKET" styleClass="step-text, step-text-active"/>
                <Region styleClass="step-line"/>
                <Label text="5" styleClass="step-dot"/>
                <Label text="REPORT" styleClass="step-text"/>
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Harvest &amp; Market" styleClass="page-title"/>
                    <Label text="Compare available buyers and confirm the best sale for your crop."
                           styleClass="page-description"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label text="HARVESTED CROP" styleClass="metric-title"/>
                    <Label fx:id="cropLabel" text="Tomato" styleClass="metric-value"/>
                </VBox>
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox spacing="13" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="1">
                            <Label text="Buyer Comparison" styleClass="section-title"/>
                            <Label text="Markets are ranked by their offered price per kilogram."
                                   styleClass="section-caption"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="BEST PRICE FOUND" styleClass="soft-badge"/>
                    </HBox>
                    <ListView fx:id="marketList" prefHeight="210" VBox.vgrow="ALWAYS"/>

                    <HBox spacing="14">
                        <VBox spacing="5" styleClass="accent-card" HBox.hgrow="ALWAYS">
                            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                            <Label text="RECOMMENDED BUYER" styleClass="metric-title"/>
                            <Label fx:id="bestMarketLabel" text="Local Market" styleClass="metric-value"/>
                        </VBox>
                        <VBox spacing="5" styleClass="warm-card" HBox.hgrow="ALWAYS">
                            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                            <Label text="BEST UNIT PRICE" styleClass="metric-title"/>
                            <Label fx:id="bestPriceLabel" text="RM 5.50 / kg" styleClass="metric-value"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="14" prefWidth="330" styleClass="card">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Sale Summary" styleClass="section-title"/>
                    <Label text="Review the final numbers before recording this transaction."
                           wrapText="true" styleClass="section-caption"/>

                    <VBox spacing="6">
                        <Label text="QUANTITY TO SELL (KG)" styleClass="metric-title"/>
                        <TextField fx:id="quantityField" promptText="Enter harvested quantity"/>
                    </VBox>

                    <Separator/>
                    <GridPane hgap="16" vgap="12">
                        <Label text="Expected revenue" styleClass="section-caption"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="revenueLabel" text="RM 0.00" styleClass="money-label"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Estimated cost" styleClass="section-caption"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="costLabel" text="RM 0.00" styleClass="value-label"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Expected profit" styleClass="section-caption"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="profitLabel" text="RM 0.00" styleClass="profit-label"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Region VBox.vgrow="ALWAYS"/>
                    <Label fx:id="statusLabel" text="Ready to complete the sale."
                           wrapText="true" maxWidth="Infinity" styleClass="status-label"/>
                    <Button fx:id="sellButton" text="Confirm &amp; Record Sale" onAction="#handleSell"
                            maxWidth="Infinity" styleClass="primary-button"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="footer-bar">
            <padding><Insets top="12" right="30" bottom="12" left="30"/></padding>
            <Label text="The confirmed transaction will be saved to the harvest log."
                   styleClass="section-caption"/>
        </HBox>
    </bottom>
</BorderPane>
    </content>
</ScrollPane>
