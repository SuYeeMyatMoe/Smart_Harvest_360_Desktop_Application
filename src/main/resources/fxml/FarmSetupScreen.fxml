<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="SmartHarvest360.controllers.FarmSetupController"
            stylesheets="@../style.css"
            fitToWidth="true" fitToHeight="true" pannable="true"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            styleClass="app-scroll">
    <content>
        <BorderPane prefWidth="960" prefHeight="680" minWidth="720" minHeight="640"
                    styleClass="app-background">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-shell">
                    <padding><Insets top="14" right="30" bottom="14" left="30"/></padding>
                    <ImageView fx:id="appLogo" fitWidth="44" fitHeight="44" preserveRatio="true" smooth="true">
                        <image><Image url="@../images/smartharvest-logo.png"/></image>
                    </ImageView>
                    <VBox spacing="1">
                        <Label text="SmartHarvest 360" styleClass="brand-title"/>
                        <Label text="Farm decision companion" styleClass="brand-caption"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="SEASON START" styleClass="screen-badge"/>
                </HBox>
            </top>

            <center>
                <VBox spacing="14" styleClass="content-wrap">
                    <padding><Insets top="18" right="30" bottom="18" left="30"/></padding>

                    <HBox alignment="CENTER" spacing="7">
                        <Label text="1" styleClass="step-dot, step-dot-active"/>
                        <Label text="SETUP" styleClass="step-text, step-text-active"/>
                        <Region styleClass="step-line"/>
                        <Label text="2" styleClass="step-dot"/>
                        <Label text="CROPS" styleClass="step-text"/>
                        <Region styleClass="step-line"/>
                        <Label text="3" styleClass="step-dot"/>
                        <Label text="SIM" styleClass="step-text"/>
                        <Region styleClass="step-line"/>
                        <Label text="4" styleClass="step-dot"/>
                        <Label text="MARKET" styleClass="step-text"/>
                        <Region styleClass="step-line"/>
                        <Label text="5" styleClass="step-dot"/>
                        <Label text="REPORT" styleClass="step-text"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Farm Setup" styleClass="page-title"/>
                            <Label text="Set Malaysia location, soil, and starting resources before planting."
                                   styleClass="page-description"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="connectionStatusLabel" text="CSV ready · MySQL offline"
                               styleClass="soft-badge"/>
                    </HBox>

                    <HBox spacing="18" VBox.vgrow="ALWAYS">
                        <VBox spacing="14" styleClass="card" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="1">
                                    <Label text="Starting Resources" styleClass="section-title"/>
                                    <Label text="These limits drive every day of the upcoming simulation."
                                           styleClass="section-caption"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="REQUIRED" styleClass="soft-badge"/>
                            </HBox>

                            <GridPane hgap="16" vgap="14">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                      GridPane.columnSpan="2">
                                    <Label text="Farm Name" styleClass="field-label"/>
                                    <TextField fx:id="farmNameField" promptText="e.g. Green Valley Farm"
                                               styleClass="form-field"/>
                                    <Label fx:id="farmNameError" text="" styleClass="validation-text"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Budget (RM)" styleClass="field-label"/>
                                    <TextField fx:id="budgetField" promptText="10000" text="10000"
                                               styleClass="form-field"/>
                                    <Label fx:id="budgetError" text="" styleClass="validation-text"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Water (L)" styleClass="field-label"/>
                                    <TextField fx:id="waterField" promptText="200" text="200"
                                               styleClass="form-field"/>
                                    <Label fx:id="waterError" text="" styleClass="validation-text"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Fertilizer (kg)" styleClass="field-label"/>
                                    <TextField fx:id="fertilizerField" promptText="20" text="20"
                                               styleClass="form-field"/>
                                    <Label fx:id="fertilizerError" text="" styleClass="validation-text"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Land (acres)" styleClass="field-label"/>
                                    <TextField fx:id="landField" promptText="5" text="5"
                                               styleClass="form-field"/>
                                    <Label fx:id="landError" text="" styleClass="validation-text"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <Label text="Location (Malaysia state)" styleClass="field-label"/>
                                    <ComboBox fx:id="locationCombo" maxWidth="Infinity" styleClass="form-field"/>
                                    <Label fx:id="locationError" text="" styleClass="validation-text"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <Label text="Soil type" styleClass="field-label"/>
                                    <ComboBox fx:id="soilCombo" maxWidth="Infinity" styleClass="form-field"/>
                                    <Label fx:id="soilError" text="" styleClass="validation-text"/>
                                </VBox>
                            </GridPane>

                            <Label fx:id="statusLabel" text="Enter your farm details to continue."
                                   styleClass="status-label"/>
                        </VBox>

                        <VBox spacing="14" prefWidth="280">
                            <VBox spacing="10" styleClass="card">
                                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                                <Label text="Season Checklist" styleClass="section-title"/>
                                <Label text="1. Name the farm and set resources"
                                       wrapText="true" styleClass="section-caption"/>
                                <Label text="2. Browse crops.csv and plant selections"
                                       wrapText="true" styleClass="section-caption"/>
                                <Label text="3. Simulate day by day until harvest"
                                       wrapText="true" styleClass="section-caption"/>
                                <Label text="4. Sell at the best market price"
                                       wrapText="true" styleClass="section-caption"/>
                                <Label text="5. Review profit, ROI, and the pie chart"
                                       wrapText="true" styleClass="section-caption"/>
                            </VBox>

                            <VBox spacing="8" styleClass="warm-card">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="HYBRID STORAGE" styleClass="metric-title"/>
                                <Label text="Crop catalog and reports stay on CSV. Farms, crops, and sales are also saved to MySQL when the database is available."
                                       wrapText="true" maxWidth="Infinity" styleClass="section-caption"/>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </center>

            <bottom>
                <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="footer-bar">
                    <padding><Insets top="13" right="30" bottom="13" left="30"/></padding>
                    <Label text="Next opens the crop database loaded from data/crops.csv."
                           styleClass="section-caption"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="nextButton" text="Next: Crop Selection" onAction="#handleNext"
                            styleClass="primary-button"/>
                </HBox>
            </bottom>
        </BorderPane>
    </content>
</ScrollPane>
