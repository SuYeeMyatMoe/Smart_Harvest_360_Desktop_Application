<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.shape.Rectangle?>
<?import SmartHarvest360.ui.Crop3DView?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="SmartHarvest360.controllers.SimulationController"
            stylesheets="@../style.css"
            fitToWidth="true"
            pannable="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="app-scroll">

    <content>

        <BorderPane prefWidth="1120"
                    minWidth="900"
                    minHeight="900"
                    styleClass="app-background">

            <top>

                <HBox alignment="CENTER_LEFT"
                      spacing="12"
                      styleClass="top-shell">

                    <padding>
                        <Insets top="14"
                                right="30"
                                bottom="14"
                                left="30"/>
                    </padding>

                    <ImageView fx:id="appLogo"
                               fitWidth="44"
                               fitHeight="44"
                               preserveRatio="true"
                               smooth="true">

                        <image>
                            <Image url="@../images/smartharvest-logo.png"/>
                        </image>

                    </ImageView>

                    <VBox spacing="1">

                        <Label text="SmartHarvest 360"
                               styleClass="brand-title"/>

                        <Label text="Farm decision companion"
                               styleClass="brand-caption"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="LIVE SEASON"
                           styleClass="screen-badge"/>

                    <Button text="FIELDS OVERVIEW"
                            onAction="#handleFieldsOverview"
                            styleClass="fields-header-button"/>

                </HBox>

            </top>


            <center>

                <VBox spacing="10"
                      styleClass="content-wrap"
                      fillWidth="true">

                    <padding>
                        <Insets top="14"
                                right="24"
                                bottom="20"
                                left="24"/>
                    </padding>


                    <!-- STEPS -->

                    <HBox alignment="CENTER"
                          spacing="7">

                        <Label text="1"
                               styleClass="step-dot, step-dot-done"/>

                        <Label text="SETUP"
                               styleClass="step-text"/>

                        <Region styleClass="step-line, step-line-done"/>


                        <Label text="2"
                               styleClass="step-dot, step-dot-done"/>

                        <Label text="CROPS"
                               styleClass="step-text"/>

                        <Region styleClass="step-line, step-line-done"/>


                        <Label text="3"
                               styleClass="step-dot, step-dot-active"/>

                        <Label text="SIM"
                               styleClass="step-text, step-text-active"/>

                        <Region styleClass="step-line"/>


                        <Label text="4"
                               styleClass="step-dot"/>

                        <Label text="MARKET"
                               styleClass="step-text"/>

                        <Region styleClass="step-line"/>


                        <Label text="5"
                               styleClass="step-dot"/>

                        <Label text="REPORT"
                               styleClass="step-text"/>

                    </HBox>


                    <!-- TITLE -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">

                        <VBox spacing="2"
                              HBox.hgrow="ALWAYS">

                            <Label text="Field Simulation"
                                   styleClass="page-title"/>

                            <Label text="Tap an action to run that day · Play auto-follows the grade coach."
                                   styleClass="page-description"/>

                        </VBox>

                        <Button fx:id="fieldsOverviewButton"
                                text="Fields Overview"
                                onAction="#handleFieldsOverview"
                                styleClass="primary-button"/>

                        <Label fx:id="statusLabel"
                               text="Ready"
                               styleClass="status-label"/>

                    </HBox>


                    <!-- METRICS -->

                    <HBox spacing="8">

                        <VBox spacing="2"
                              styleClass="metric-card"
                              HBox.hgrow="ALWAYS">

                            <Label text="DAY"
                                   styleClass="metric-title"/>

                            <Label fx:id="dayLabel"
                                   text="1"
                                   styleClass="metric-value"/>

                        </VBox>


                        <VBox spacing="2"
                              styleClass="metric-card"
                              HBox.hgrow="ALWAYS">

                            <Label text="WEATHER"
                                   styleClass="metric-title"/>

                            <Label fx:id="weatherLabel"
                                   text="Sunny"
                                   styleClass="metric-value"/>

                        </VBox>


                        <VBox spacing="2"
                              styleClass="metric-card"
                              HBox.hgrow="ALWAYS">

                            <Label text="WATER"
                                   styleClass="metric-title"/>

                            <Label fx:id="waterLabel"
                                   text="200 L"
                                   styleClass="metric-value"/>

                        </VBox>


                        <VBox spacing="2"
                              styleClass="metric-card"
                              HBox.hgrow="ALWAYS">

                            <Label text="FERTILIZER"
                                   styleClass="metric-title"/>

                            <Label fx:id="fertilizerLabel"
                                   text="20 kg"
                                   styleClass="metric-value"/>

                        </VBox>


                        <VBox spacing="2"
                              styleClass="accent-card"
                              HBox.hgrow="ALWAYS">

                            <padding>
                                <Insets top="8"
                                        right="10"
                                        bottom="8"
                                        left="10"/>
                            </padding>

                            <Label text="LIVE GRADE"
                                   styleClass="metric-title"/>

                            <Label fx:id="liveGradeLabel"
                                   text="C"
                                   styleClass="metric-value"/>

                        </VBox>


                        <VBox spacing="2"
                              styleClass="warm-card"
                              HBox.hgrow="ALWAYS">

                            <padding>
                                <Insets top="8"
                                        right="10"
                                        bottom="8"
                                        left="10"/>
                            </padding>

                            <Label text="CARE"
                                   styleClass="metric-title"/>

                            <Label fx:id="careScoreLabel"
                                   text="50"
                                   styleClass="metric-value"/>

                        </VBox>

                    </HBox>


                    <!-- MAIN SIMULATION -->

                    <HBox spacing="12">


                        <!-- FIELD -->

                        <VBox spacing="8"
                              styleClass="card"
                              prefWidth="290"
                              minWidth="290">

                            <padding>
                                <Insets top="12"
                                        right="12"
                                        bottom="12"
                                        left="12"/>
                            </padding>


                            <HBox alignment="CENTER_LEFT">

                                <Label text="Crop Field"
                                       styleClass="section-title"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="cropLabel"
                                       text="Tomato"
                                       styleClass="soft-badge"/>

                            </HBox>


                            <!-- CROP FIELD -->

                            <StackPane fx:id="fieldPane"
                                       prefWidth="266"
                                       minWidth="266"
                                       maxWidth="266"
                                       prefHeight="230"
                                       minHeight="230"
                                       maxHeight="230"
                                       styleClass="sim-field">


                                <!-- SKY -->

                                <Rectangle fx:id="skyRect"
                                           width="266"
                                           height="230"
                                           arcWidth="18"
                                           arcHeight="18"
                                           fill="TRANSPARENT"
                                           visible="false"
                                           managed="false"/>


                                <!-- 3D FALLBACK + VIDEO -->

                                <Crop3DView fx:id="crop3dView"
                                            prefWidth="266"
                                            prefHeight="230"
                                            minWidth="266"
                                            minHeight="230"
                                            maxWidth="266"
                                            maxHeight="230"
                                            visible="false"/>

                    <MediaView fx:id="plantVideoView"
                               fitWidth="266"
                               fitHeight="230"
                               preserveRatio="false"
                               smooth="true"
                               visible="false"/>


                                <Rectangle fx:id="soilRect"
                                           width="266"
                                           height="42"
                                           fill="TRANSPARENT"
                                           visible="false"
                                           managed="false"/>


                                <!-- WEATHER -->

                                <Label text="GROWTH VIDEO"
                                       styleClass="model-3d-badge"
                                       StackPane.alignment="BOTTOM_LEFT"
                                       translateX="10"
                                       translateY="-10"/>

                                <Label fx:id="fieldWeatherBadge"
                                       text="Sunny"
                                       styleClass="field-weather-badge"
                                       StackPane.alignment="TOP_RIGHT"
                                       translateX="-10"
                                       translateY="10"/>

                            </StackPane>


                            <!-- GROWTH -->

                            <HBox>

                                <Label text="Growth"
                                       styleClass="section-caption"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="progressLabel"
                                       text="0%"
                                       styleClass="value-label"/>

                            </HBox>


                            <ProgressBar fx:id="growthProgress"
                                         progress="0"
                                         maxWidth="Infinity"
                                         styleClass="sim-growth-bar"/>


                            <!-- CONTROLS -->

                            <HBox spacing="8"
                                  alignment="CENTER_LEFT">

                                <Button fx:id="playPauseButton"
                                        text="Play"
                                        onAction="#handlePlayPause"
                                        styleClass="primary-button"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>

                                <Button fx:id="nextDayButton"
                                        text="Coach step"
                                        onAction="#handleNextDay"
                                        styleClass="secondary-button"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>

                            </HBox>


                            <!-- SPEED -->

                            <HBox alignment="CENTER_LEFT"
                                  spacing="8">

                                <Label text="Speed"
                                       styleClass="section-caption"/>

                                <Slider fx:id="speedSlider"
                                        min="0.5"
                                        max="8"
                                        value="2"
                                        majorTickUnit="1.5"
                                        minorTickCount="2"
                                        showTickMarks="true"
                                        showTickLabels="false"
                                        HBox.hgrow="ALWAYS"/>

                                <Label fx:id="speedLabel"
                                       text="2.0×"
                                       styleClass="value-label"
                                       minWidth="36"/>

                            </HBox>

                        </VBox>


                        <!-- ACTIVITY LOG -->

                        <VBox spacing="8"
                              styleClass="card"
                              HBox.hgrow="ALWAYS"
                              minWidth="400">

                            <padding>
                                <Insets top="12"
                                        right="12"
                                        bottom="12"
                                        left="12"/>
                            </padding>


                            <HBox alignment="CENTER_LEFT">

                                <Label text="Activity Log"
                                       styleClass="section-title"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label text="TABLE"
                                       styleClass="soft-badge"/>

                            </HBox>


                            <TableView fx:id="activityTable"
                                       styleClass="sim-log-table"
                                       prefHeight="420"
                                       minHeight="420"
                                       maxHeight="420">

                                <columns>

                                    <TableColumn fx:id="dayCol"
                                                 text="Day"
                                                 prefWidth="52"/>

                                    <TableColumn fx:id="weatherCol"
                                                 text="Weather"
                                                 prefWidth="80"/>

                                    <TableColumn fx:id="actionCol"
                                                 text="Action"
                                                 prefWidth="90"/>

                                    <TableColumn fx:id="waterCol"
                                                 text="Water L"
                                                 prefWidth="78"/>

                                    <TableColumn fx:id="fertCol"
                                                 text="Fert kg"
                                                 prefWidth="72"/>

                                    <TableColumn fx:id="growthCol"
                                                 text="Growth"
                                                 prefWidth="70"/>

                                    <TableColumn fx:id="statusCol"
                                                 text="Status"
                                                 prefWidth="160"/>

                                </columns>

                            </TableView>

                        </VBox>


                        <!-- COACH -->

                        <VBox spacing="8"
                              styleClass="card"
                              prefWidth="300"
                              minWidth="300">

                            <padding>
                                <Insets top="12"
                                        right="12"
                                        bottom="12"
                                        left="12"/>
                            </padding>


                            <Label text="Field actions"
                                   styleClass="section-title"/>

                            <Label text="Tap to run 1 day"
                                   styleClass="section-caption"/>


                            <GridPane hgap="8"
                                      vgap="8">

                                <columnConstraints>

                                    <ColumnConstraints percentWidth="50"/>

                                    <ColumnConstraints percentWidth="50"/>

                                </columnConstraints>


                                <Button fx:id="irrigateButton"
                                        text="Irrigate"
                                        onAction="#handleIrrigate"
                                        styleClass="action-card-compact"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="0"/>


                                <Button fx:id="conserveButton"
                                        text="Conserve"
                                        onAction="#handleConserve"
                                        styleClass="action-card-compact"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="0"/>


                                <Button fx:id="fertilizeButton"
                                        text="Fertilize"
                                        onAction="#handleFertilize"
                                        styleClass="action-card-compact"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="1"/>


                                <Button fx:id="protectButton"
                                        text="Protect"
                                        onAction="#handleProtect"
                                        styleClass="action-card-compact"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="1"/>

                            </GridPane>


                            <!-- GRADE COACH -->

                            <VBox spacing="4"
                                  styleClass="warm-card">

                                <padding>
                                    <Insets top="8"
                                            right="10"
                                            bottom="8"
                                            left="10"/>
                                </padding>


                                <Label text="GRADE COACH"
                                       styleClass="metric-title"/>


                                <Label fx:id="recommendedActionLabel"
                                       text="Irrigate"
                                       styleClass="metric-value"/>


                                <Label fx:id="dailyTipLabel"
                                       text="—"
                                       wrapText="true"
                                       maxWidth="Infinity"
                                       maxHeight="48"
                                       styleClass="section-caption"/>


                                <Button fx:id="applyTipButton"
                                        text="Do suggested now"
                                        onAction="#handleApplyTip"
                                        styleClass="primary-button"
                                        maxWidth="Infinity"/>

                            </VBox>


                            <Label fx:id="predictedGradeSimLabel"
                                   text="Plant-time grade: —"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   styleClass="section-caption"/>


                            <Label fx:id="fertilizerPlanSimLabel"
                                   text="Fertilizer: —"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   styleClass="section-caption"/>


                            <Label fx:id="lastActionLabel"
                                   text="Last action: —"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   styleClass="section-caption"/>


                            <Region VBox.vgrow="ALWAYS"/>


                            <Button text="Fields Overview"
                                    onAction="#handleFieldsOverview"
                                    styleClass="secondary-button"
                                    maxWidth="Infinity"/>

                            <Button fx:id="harvestButton"
                                    text="View Detailed Plan"
                                    onAction="#handleGoToHarvest"
                                    visible="false"
                                    managed="false"
                                    styleClass="primary-button"
                                    maxWidth="Infinity"/>

                        </VBox>

                    </HBox>

                </VBox>

            </center>

        </BorderPane>

    </content>

</ScrollPane>