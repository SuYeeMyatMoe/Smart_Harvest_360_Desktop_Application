 <Worksheet ss:Name="Recommendations">
  <Table>
   <Row><Cell ss:StyleID="Title" ss:MergeAcross="4"><Data ss:Type="String">Plan recommendations</Data></Cell></Row>
   <Row>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Priority</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Topic</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Advice</Data></Cell>
   </Row>
   <Row>
<Cell><Data ss:Type="String">High</Data></Cell><Cell><Data ss:Type="String">Next action habit</Data></Cell><Cell><Data ss:Type="String">On Storm/Heat days always choose Protect first - that is the fastest grade saver.</Data></Cell>   </Row>
   <Row>
<Cell><Data ss:Type="String">High</Data></Cell><Cell><Data ss:Type="String">Fertilizer plan</Data></Cell><Cell><Data ss:Type="String">Follow Medium plan: Apply about 2.0 kg split early/mid season (1.0× need).</Data></Cell>   </Row>
   <Row>
<Cell><Data ss:Type="String">Medium</Data></Cell><Cell><Data ss:Type="String">Keep momentum</Data></Cell><Cell><Data ss:Type="String">Care 100 supports live grade S. Keep following coach tips through harvest.</Data></Cell>   </Row>
   <Row>
<Cell><Data ss:Type="String">Low</Data></Cell><Cell><Data ss:Type="String">Grade upside</Data></Cell><Cell><Data ss:Type="String">You improved the path to S from A. Sell promptly at the best market to lock results.</Data></Cell>   </Row>
   <Row>
<Cell><Data ss:Type="String">Medium</Data></Cell><Cell><Data ss:Type="String">Market next</Data></Cell><Cell><Data ss:Type="String">Continue to Harvest &amp; Market, sell at the best buyer, then download the season CSV on Report.</Data></Cell>   </Row>
  </Table>
